+def _inject_spotters(d):
+    """Локальные команды колонки без фразы «Алиса»: «включи свет», «тише», «дальше».
+
+    Группы командных споттеров и always-on микрофон: колонка хранит их в
+    user_config.dat и перезаписывает при каждой синхронизации тем, что пришло
+    отсюда, поэтому включать надо в ответе sync, а не на колонке.
+    """
+    acc = d.setdefault("config", {}).setdefault("account_config", {})
+    groups = {
+        "call": ("answer",),
+        "music": ("bluetooth", "feedback", "navigation", "playAndPause", "volume"),
+        "smartHome": ("light", "tv"),
+        "tv": ("backToHome", "navigation"),
+    }
+    spotters = acc.setdefault("enabledCommandSpotters", {})
+    for group, names in groups.items():
+        section = spotters.setdefault(group, {})
+        for name in names:
+            section[name] = True
+    acc["alwaysOnMicForShortcuts"] = True
+    return d
+
+
+# Пользовательские настройки колонки из дашборда (sparse {account_config:{}, device_config:{}}).
+# Читается при каждом запросе; любая ошибка — отдаём ответ как раньше, без наложения.
+SYNC_OVERLAY = os.environ.get("AISIS_SYNC_OVERLAY") or os.path.join(
+    os.path.expanduser("~"), ".config", "aisis-yandex", "speaker-sync-overlay.json")
+_OVERLAY_SECTIONS = ("account_config", "device_config")
+_OVERLAY_SKIP = {"account_config": ("enabledCommandSpotters",)}   # локальные команды владельца не трогаем
+
+
+def _overlay_merge(base, patch, skip=()):
+    for k, v in patch.items():
+        if k in skip:
+            continue
+        if isinstance(v, dict) and isinstance(base.get(k), dict):
+            _overlay_merge(base[k], v)
+        else:
+            base[k] = v
+
+
+def _apply_overlay(d):
+    """Накладывает overlay ПОСЛЕ инъекций (alwaysOnMicForShortcuts можно изменить, enabledCommandSpotters — нет)."""
+    try:
+        with open(SYNC_OVERLAY, encoding="utf-8") as fh:
+            ov = json.load(fh)
+        if not isinstance(ov, dict):
+            return d
+        out = json.loads(json.dumps(d))
+        cfg = out.setdefault("config", {})
+        for sec in _OVERLAY_SECTIONS:
+            patch = ov.get(sec)
+            if isinstance(patch, dict) and patch:
+                _overlay_merge(cfg.setdefault(sec, {}), patch, _OVERLAY_SKIP.get(sec, ()))
+        return out
+    except Exception:
+        return d
+
 
